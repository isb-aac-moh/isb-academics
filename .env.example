# Same Supabase project as isb-explorer — get from supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog analytics — the dev server throws at startup if the token is missing
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your-posthog-project-token
# Capture goes through the first-party /ingest proxy (a Vercel rewrite) to dodge
# ad blockers. That path only resolves on Vercel; set the direct host below if
# you need events during local development.
VITE_PUBLIC_POSTHOG_HOST=/ingest
